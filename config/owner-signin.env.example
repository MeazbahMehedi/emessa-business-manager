# Real Google sign-in template. Copy to ignored .dev.vars on your own computer.
# Fill the blank settings through the owner setup guide. Empty values deny access.
APP_ENV=local
APP_ORIGIN=http://localhost:5173
LOCAL_DEMO=false
ADMIN_EMAIL=
BUSINESS_TIMEZONE=UTC
SESSION_VERSION=1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SCRIPT_DEPLOYMENT_ID=
# The owner authorization helper generates these three settings after consent:
ADMIN_GOOGLE_SUB=
GOOGLE_REFRESH_TOKEN=
SESSION_SECRET=
