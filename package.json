{
  "name": "emessa-business-manager",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "npm run build && wrangler deploy",
    "setup:google": "node tools/authorize_google.mjs",
    "verify:readonly": "node tools/check_readonly_source.mjs",
    "build:inventory": "node tools/build_inventory_script.mjs",
    "verify:inventory": "node tools/build_inventory_script.mjs --check",
    "setup:inventory": "node tools/authorize_google.mjs --inventory",
    "check:inventory": "node tools/check_inventory.mjs"
  },
  "dependencies": {
    "hono": "4.13.16",
    "jose": "6.2.15",
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261104.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.158.0",
    "esbuild": "0.28.2"
  }
}
